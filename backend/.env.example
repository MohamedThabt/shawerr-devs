APP_APP_NAME=World Monitor
APP_APP_VERSION=1.0.0
# development (default): /docs, /redoc, /openapi.json enabled. production: they are disabled.
APP_APP_ENV=development

# CORS – comma-separated allowed origins (e.g. https://yourdomain.com,https://www.yourdomain.com)
APP_CORS_ORIGINS=http://localhost:5173

# Logging
APP_LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR | CRITICAL

# Google Gemini / LangChain
APP_GOOGLE_API_KEY=your-gemini-api-key-here
APP_GEMINI_MODEL=gemini-3-flash-preview

# Ollama / AI Brief
# If running inside Docker Compose, use: http://ollama:11434
APP_OLLAMA_BASE_URL=http://localhost:11434
APP_OLLAMA_MODEL=llama3.2
APP_OLLAMA_TIMEOUT=90
APP_OLLAMA_NUM_PREDICT=1024

# Database
DATABASE_URL=postgresql+asyncpg://app_user:app_pass@localhost:5432/app_db